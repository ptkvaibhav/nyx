{
  "name": "nyx",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "nyx": "./src/cli.js"
  },
  "description": "High-integrity, safety-first file intelligence and organization system with SQLite persistence and cloud-bridge capabilities.",
  "keywords": [
    "file-management",
    "automation",
    "data-protection",
    "sqlite",
    "nodejs",
    "safety-first",
    "duplicate-detection",
    "intelligent-organization",
    "backup-system",
    "cli-tool",
    "metadata-management",
    "rollback-engine",
    "incremental-scan"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cli.js",
    "plan": "node src/cli.js plan",
    "doctor": "node src/cli.js doctor",
    "demo": "node src/cli.js demo",
    "init-drive": "node src/cli.js init-drive",
    "drive-status": "node src/cli.js drive-status",
    "sync-file": "node src/cli.js sync-file",
    "fingerprint": "node src/cli.js fingerprint",
    "classify": "node src/cli.js classify",
    "check:quality": "node scripts/check-quality.js",
    "check:security": "node scripts/check-security.js",
    "test:smoke": "node scripts/run-smoke.js",
    "test": "node --test test/engagement.test.js test/executor.test.js test/local-audit.test.js test/local-drive.test.js test/protection.test.js test/review-queue.test.js",
    "ui:build": "cd ui && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "open": "^11.0.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "jscpd": "^5.0.11",
    "knip": "^6.20.0",
    "npm-check-updates": "^22.2.7"
  }
}
